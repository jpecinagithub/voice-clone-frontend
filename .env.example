# Vercel environment variables (Project Settings → Environment Variables).
# Never commit real values. The browser never sees these.

# Public HTTPS URL of the Cloudflare Tunnel pointing at the voice gateway,
# e.g. https://trademarks-commission-pdas-head.trycloudflare.com
GATEWAY_URL=

# Token from the server's ~/PROYECTOS/voicestudio/.env (GATEWAY_TOKEN=...)
GATEWAY_TOKEN=
